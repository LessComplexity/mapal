fn main() {
    4194304 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 9 + 1 -> widen_f32 } -> x;
    ta -> map { t -> (t * 5 + 29) % 9 + 1 -> widen_f32 } -> w1;
    ta -> map { t -> (t * 3 + 41) % 9 + 1 -> widen_f32 } -> w2;
    2048 -> iota -> kr;
    () -> time -> t0;
    ta -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, kr) -> fold { acc, k -> acc + x[i * 2048 + k] * w1[k * 2048 + j] }
    } -> h1;
    ta -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, kr) -> fold { acc, k -> acc + h1[i * 2048 + k] * w2[k * 2048 + j] }
    } -> h2;
    () -> time -> t1;
    h2[0] -> println;
    h2[4194303] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
