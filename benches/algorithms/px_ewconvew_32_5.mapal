fn main() {
    25 -> iota -> i_wk;
    i_wk -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> wk;
    1296 -> iota -> i_img;
    i_img -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> img;
    img -> map { v -> v * 0.5 + 0.25 } -> im;
    1024 -> iota -> o_y;
    25 -> iota -> k_y;
    o_y -> map { t ->
        t / 32 -> i;
        t % 32 -> j;
        (0.0, k_y) -> fold { acc, k -> acc + wk[k] * im[(i + k / 5) * 36 + j + k % 5] }
    } -> y;
    y -> map { v -> v -> u; (u > 0.0) -> { -true-> u; -false-> 0.0; } -> r; r } -> z;
    0.0 -> zero: f32;
    (zero, z) -> fold { acc, v -> acc + v } -> s_z;
    s_z -> println;
    z[0] -> println;
    z[1023] -> println;
}
