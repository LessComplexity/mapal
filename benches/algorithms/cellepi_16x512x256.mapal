fn main() {
    4096 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> x; x / 7.0 } -> a;
    131072 -> iota -> tb;
    tb -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> x; x / 9.0 } -> b;
    256 -> iota -> krange;
    8192 -> iota -> tc;
    tc -> map { t ->
        t / 512 -> i;
        t % 512 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 256 + k] * b[k * 512 + j] }
    } -> c;
    c -> map { v -> v * 0.5 + 1.0 } -> d;
    (0.0, d) -> fold { acc, v -> acc + v } -> total;
    total -> println;
    d[0] -> println;
    d[8191] -> println;
}
