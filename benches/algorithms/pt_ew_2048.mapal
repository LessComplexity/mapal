fn main() {
    4194304 -> iota -> ta;
    2048 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    () -> time -> t0;
    a -> map { v -> v * 3.0 } -> x;
    x -> map { v -> v + 2.0 } -> y;
    ta -> map { t -> y[t] * b[t] } -> z;
    () -> time -> t1;
    z[0] -> println;
    z[4194303] -> println;
    "iter ms=" -> print;
