fn main() {
    67108864 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    8192 -> iota -> krange;
    ta -> map { t ->
        t / 8192 -> i;
        t % 8192 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 8192 + k] * b[k * 8192 + j] }
    } -> c;
    c[0] -> println;
}
