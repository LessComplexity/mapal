fn main() {
    1048576 -> iota -> ta;
    1024 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    ta -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> e;
    () -> time -> t0;
    ta -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 1024 + k] * b[k * 1024 + j] }
    } -> c;
    c -> map { v -> v * 0.5 } -> h;
    ta -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, krange) -> fold { acc, k -> acc + h[i * 1024 + k] * e[k * 1024 + j] }
    } -> d;
    d[0] -> r0_d;
    d[1048575] -> r1_d;
    () -> time -> t1;
    r0_d -> println;
    r1_d -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
