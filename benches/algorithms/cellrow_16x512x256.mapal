fn main() {
    4096 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> x; x / 7.0 } -> a;
    131072 -> iota -> tb;
    tb -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> x; x / 9.0 } -> b;
    256 -> iota -> krange;
    8192 -> iota -> tc;
    tc -> map { t ->
        t / 512 -> i;
        t % 512 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 256 + k] * b[k * 512 + j] }
    } -> c;
    16 -> iota -> rr;
    512 -> iota -> jr;
    rr -> map { i -> (0.0, jr) -> fold { acc, j -> acc + c[i * 512 + j] } } -> r;
    (0.0, r) -> fold { acc, v -> acc + v } -> total;
    total -> println;
    r[0] -> println;
    r[15] -> println;
}
