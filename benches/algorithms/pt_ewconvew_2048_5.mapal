fn main() {
    25 -> iota -> i_wk;
    i_wk -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> wk;
    4210704 -> iota -> i_img;
    i_img -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> img;
    () -> time -> t0;
    img -> map { v -> v * 0.5 + 0.25 } -> im;
    4194304 -> iota -> o_y;
    25 -> iota -> k_y;
    o_y -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, k_y) -> fold { acc, k -> acc + wk[k] * im[(i + k / 5) * 2052 + j + k % 5] }
    } -> y;
    y -> map { v -> v -> u; (u > 0.0) -> { -true-> u; -false-> 0.0; } -> r; r } -> z;
    () -> time -> t1;
    z[0] -> println;
    z[4194303] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
