fn main() {
    524288 -> iota -> i_a;
    i_a -> map {
        t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v;
        v / 7.0
    } -> a;
    25165824 -> iota -> i_b;
    i_b -> map {
        t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v;
        v / 9.0
    } -> b;
    () -> time -> t0;
    786432 -> iota -> o_c;
    4096 -> iota -> k_c;
    o_c -> map {
        t ->
        t / 6144 -> i;
        t % 6144 -> j;
        (0.0, k_c) -> fold {
            acc, k -> acc + a[i * 4096 + k] * b[k * 6144 + j]
        }
    } -> c;
