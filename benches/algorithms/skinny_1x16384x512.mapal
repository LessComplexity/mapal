fn main() {
    512 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> x; x / 7.0 } -> a;
    8388608 -> iota -> tb;
    tb -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> x; x / 9.0 } -> b;
    512 -> iota -> krange;
    16384 -> iota -> tc;
    tc -> map { t ->
        t / 16384 -> i;
        t % 16384 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 512 + k] * b[k * 16384 + j] }
    } -> c;
    (0.0, c) -> fold { acc, v -> acc + v } -> total;
    total -> println;
    c[0] -> println;
    c[16383] -> println;
}
