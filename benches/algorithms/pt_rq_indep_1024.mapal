fn main() {
    1048576 -> iota -> ta;
    1024 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    ta -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> e;
    ta -> map { t -> (t * 3 + 1) % 89 - 44 -> widen_f32 -> v; v / 13.0 } -> f;
    () -> time -> t0;
    ta -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 1024 + k] * b[k * 1024 + j] }
    } -> c;
    ta -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, krange) -> fold { acc, k -> acc + e[i * 1024 + k] * f[k * 1024 + j] }
    } -> d;
    ta -> map { t -> c[t] + d[t] } -> g;
    g[0] -> r0_g;
    g[1048575] -> r1_g;
    () -> time -> t1;
    r0_g -> println;
    r1_g -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
