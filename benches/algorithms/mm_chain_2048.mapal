fn main() {
    4194304 -> iota -> ta;
    2048 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    ta -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> e;
    ta -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 2048 + k] * b[k * 2048 + j] }
    } -> c;
    ta -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, krange) -> fold { acc, k -> acc + c[i * 2048 + k] * e[k * 2048 + j] }
    } -> d;
    d[0] -> println;
}
