    } -> g2;
    6144 -> iota -> i_wg;
    i_wg -> map {
        t -> (t % 89 * 3 + 1) % 89 - 44 -> widen_f32 -> v;
        v / 232.0
    } -> wg;
    6144 -> iota -> i_wu;
    i_wu -> map {
        t -> (t % 107 * 13 + 7) % 107 - 53 -> widen_f32 -> v;
        v / 232.0
    } -> wu;
    6144 -> iota -> i_wd;
    i_wd -> map {
        t -> (t % 109 * 17 + 29) % 109 - 54 -> widen_f32 -> v;
        v / 284.1
    } -> wd;
    12 -> iota -> rR;
    64 -> iota -> rD;
    768 -> iota -> rRD;
    1536 -> iota -> rRQ;
    16 -> iota -> rdh;
    16 -> iota -> r16;
    96 -> iota -> rF;
    1152 -> iota -> rRF;
    12 -> iota -> rT;
    384 -> iota -> rTK;
    48 -> iota -> rHT;
    576 -> iota -> rHTT;
    rR -> map {
        b -> (0.0, rD) -> fold {
            acc, i -> x0[b * 64 + i] -> rv;
            acc + rv * rv
        } -> ss;
        ss / 64.0 + 0.00001 -> ra;
        0.5 + 0.5 * ra -> s0;
        (s0, r16) -> fold {
            acc, k -> 0.5 * (acc + ra / acc)
        } -> sd;
        1.0 / sd
    } -> rinv;
    rRD -> map {
        e -> x0[e] * rinv[e / 64] * g1[e % 64]
    } -> xn;
    rRQ -> map {
        e -> e / 128 -> i;
        e % 128 -> j;
        (0.0, rD) -> fold {
            acc, k -> acc + xn[i * 64 + k] * wqkv[k * 128 + j]
        }
    } -> qkv;
    rRD -> map {
        e -> e / 64 -> i;
        e % 64 -> c;
        c % 16 -> ri;
        (ri < 8) -> {
            -true-> qkv[i * 128 + c] * cs[i * 8 + ri] - qkv[i * 128 + c + 8] * sn[i * 8 + ri];
            -false-> qkv[i * 128 + c] * cs[i * 8 + ri - 8] + qkv[i * 128 + c - 8] * sn[i * 8 + ri - 8];
        }
    } -> q;
    rTK -> map {
        e -> e / 32 -> i;
        e % 32 -> u;
        u % 16 -> ri;
        (ri < 8) -> {
            -true-> qkv[i * 128 + 64 + u] * cs[i * 8 + ri] - qkv[i * 128 + 64 + u + 8] * sn[i * 8 + ri];
            -false-> qkv[i * 128 + 64 + u] * cs[i * 8 + ri - 8] + qkv[i * 128 + 64 + u - 8] * sn[i * 8 + ri - 8];
        }
    } -> kr;
    rHTT -> map {
        e -> e / 144 -> hh;
        e / 12 % 12 -> i;
        e % 12 -> r;
        (r <= i) -> {
            -true-> {
                (0.0, rdh) -> fold {
                    acc, u -> acc + q[i * 64 + (hh) * 16 + u] * kr[r * 32 + (hh / 2) * 16 + u]
                } -> dt;
                dt / 4.0000000
            }
            -false-> -1000000000.0;
        }
    } -> s;
    rHT -> map {
        hi -> (-1000000000.0, rT) -> fold {
            acc, r -> s[hi * 12 + r] -> se;
