    } -> attf;
    rRD -> map {
        e -> e / 64 -> i;
        e % 64 -> j;
        (0.0, rD) -> fold {
            acc, k -> acc + attf[i * 64 + k] * wo[k * 64 + j]
        } -> y;
        x0[e] + y
    } -> h1;
    rR -> map {
        b -> (0.0, rD) -> fold {
            acc, i -> h1[b * 64 + i] -> rv;
            acc + rv * rv
        } -> ss;
        ss / 64.0 + 0.00001 -> ra;
        0.5 + 0.5 * ra -> s0;
        (s0, r16) -> fold {
            acc, k -> 0.5 * (acc + ra / acc)
        } -> sd;
        1.0 / sd
    } -> rinv2;
    rRD -> map {
        e -> h1[e] * rinv2[e / 64] * g2[e % 64]
    } -> hn;
    rRF -> map {
        e -> e / 96 -> b;
        e % 96 -> j;
        (0.0, rD) -> fold {
            acc, k -> acc + hn[b * 64 + k] * wg[k * 96 + j]
        }
    } -> gt;
    rRF -> map {
        e -> e / 96 -> b;
        e % 96 -> j;
        (0.0, rD) -> fold {
            acc, k -> acc + hn[b * 64 + k] * wu[k * 96 + j]
        }
    } -> up;
    rRF -> map {
        e -> gt[e] -> sv;
        (sv > 0.0) -> {
            -true-> {
                0.0 - sv -> nz;
                (nz > -80.0) -> {
                    -true-> {
                        nz / 256.0 -> ny;
                        1.0 + ny * (1.0 + ny * (0.5 + ny * (0.16666667 + ny * (0.041666668 + ny * 0.008333334)))) -> np;
                        8 -> iota -> nq;
                        (np, nq) -> fold {
                            acc, k -> acc * acc
                        }
                    }
                    -false-> 0.0;
                } -> en;
                sv / (1.0 + en)
            }
            -false-> {
                sv -> mz;
                (mz > -80.0) -> {
                    -true-> {
                        mz / 256.0 -> my;
                        1.0 + my * (1.0 + my * (0.5 + my * (0.16666667 + my * (0.041666668 + my * 0.008333334)))) -> mp;
                        8 -> iota -> mq;
                        (mp, mq) -> fold {
                            acc, k -> acc * acc
                        }
                    }
                    -false-> 0.0;
                } -> em;
                sv * em / (1.0 + em)
            }
        } -> sg;
        sg * up[e]
    } -> hh;
    rRD -> map {
        e -> e / 64 -> b;
        e % 64 -> j;
        (0.0, rF) -> fold {
            acc, k -> acc + hh[b * 96 + k] * wd[k * 64 + j]
        } -> y2;
        h1[e] + y2
    } -> out;
    out[0] -> println;
    out[705] -> println;
    out[387] -> println;
    out[767] -> println;
    0.0 -> zero: f32;
    (zero, out) -> fold {
