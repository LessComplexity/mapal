fn main() {
    4194304 -> iota -> ta;
    2048 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    ta -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> e;
    ta -> map { t -> (t * 3 + 1) % 89 - 44 -> widen_f32 -> v; v / 13.0 } -> f;
    () -> time -> t0;
    ta -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 2048 + k] * b[k * 2048 + j] }
    } -> c;
    ta -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, krange) -> fold { acc, k -> acc + e[i * 2048 + k] * f[k * 2048 + j] }
    } -> d;
    c[0] -> r0_c;
    c[4194303] -> r1_c;
    d[0] -> r0_d;
    d[4194303] -> r1_d;
    () -> time -> t1;
    r0_c -> println;
    r1_c -> println;
    r0_d -> println;
    r1_d -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
