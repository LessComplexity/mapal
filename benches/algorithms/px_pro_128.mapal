fn main() {
    16384 -> iota -> ta;
    128 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    a -> map { v -> v * 0.25 } -> a2;
    ta -> map { t ->
        t / 128 -> i;
        t % 128 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a2[i * 128 + k] * b[k * 128 + j] }
    } -> c;
    0.0 -> zero: f32;
    (zero, c) -> fold { acc, v -> acc + v } -> s_c;
    s_c -> println;
    c[0] -> println;
    c[16383] -> println;
}
