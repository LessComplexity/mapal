fn main() {
    16384 -> iota -> ta;
    128 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    ta -> map { t ->
        t / 128 -> i;
        t % 128 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 128 + k] * b[k * 128 + j] }
    } -> c;
    krange -> map { i -> (0.0, krange) -> fold { acc, j -> acc + c[i * 128 + j] } } -> r;
    0.0 -> zero: f32;
    (zero, r) -> fold { acc, v -> acc + v } -> s_r;
    s_r -> println;
    r[0] -> println;
    r[127] -> println;
}
