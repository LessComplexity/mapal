fn main() {
    65536 -> iota -> tw;
    tw -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> x; x / 4096.0 } -> wk;
    tw -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> x; x / 4096.0 } -> wv;
    262144 -> iota -> tc;
    256 -> iota -> krange;
    1024 -> iota -> rrange;
    tc -> map { c -> (c / 256 < 512) -> { -true-> { (c * 7 + 13) % 101 - 50 -> widen_f32 -> f; f / 64.0 } -false-> 0.0; } } -> x0;
    () -> time -> pf0;
    tc -> map { c ->
                    c / 256 -> i;
                    c % 256 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + x0[i * 256 + k] * wk[k * 256 + j] }
                } -> k0;
    tc -> map { c ->
                    c / 256 -> i;
                    c % 256 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + x0[i * 256 + k] * wv[k * 256 + j] }
                } -> v0;
    131072 -> iota -> pq;
    pq -> map { e -> (e * 5 + 3) % 97 - 48 -> widen_f32 -> qv; qv / 4096.0 } -> qp;
    524288 -> iota -> ps_i;
    512 -> iota -> prange;
    ps_i -> map { e -> e / 1024 -> i; e % 1024 -> r; (r <= i) -> { -true-> { (0.0, krange) -> fold { acc, k -> acc + qp[i * 256 + k] * k0[r * 256 + k] } } -false-> -1000000000.0; } } -> ps;
    prange -> map { i -> (-1000000000.0, rrange) -> fold { acc, r -> ps[i * 1024 + r] -> e; (e > acc) -> { -true-> e; -false-> acc; } } } -> pmx;
    ps_i -> map { e -> e / 1024 -> i; e % 1024 -> r; (r <= i) -> { -true-> { (ps[e] - pmx[i]) / 16.0 -> ez; ez / 256.0 + 1.0 -> eu; (eu > 0.0) -> { -true-> eu; -false-> 0.0; } -> ev; 8 -> iota -> esq; (ev, esq) -> fold { acc, k -> acc * acc } } -false-> 0.0; } } -> pp;
    prange -> map { i -> (0.0, rrange) -> fold { acc, r -> acc + pp[i * 1024 + r] } } -> pden;
    pq -> map { e -> e / 256 -> i; e % 256 -> j; (0.0, rrange) -> fold { acc, r -> acc + pp[i * 1024 + r] * v0[r * 256 + j] } -> a; a / pden[i] } -> po;
    krange -> map { j -> po[130816 + j] } -> o0;
    mut x: [f32; 262144] <- x0;
    mut o: [f32; 256] <- o0;
    mut t: i32 <- 512;
    () -> time -> t0;
    loop {
        (t < 1024) -> {
            -true-> {
                tc -> map { c -> (c / 256 == t) -> { -true-> { (c * 7 + 13) % 101 - 50 -> widen_f32 -> f; f / 64.0 + o[c % 256] } -false-> x[c]; } } -> x;
                tc -> map { c ->
                    c / 256 -> i;
                    c % 256 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + x[i * 256 + k] * wk[k * 256 + j] }
                } -> kk;
                tc -> map { c ->
                    c / 256 -> i;
                    c % 256 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + x[i * 256 + k] * wv[k * 256 + j] }
                } -> vv;
                krange -> map { k -> ((t * 256 + k) * 5 + 3) % 97 - 48 -> widen_f32 -> qv; qv / 4096.0 } -> q;
                rrange -> map { r -> (r <= t) -> { -true-> { (0.0, krange) -> fold { acc, k -> acc + q[k] * kk[r * 256 + k] } } -false-> -1000000000.0; } } -> s;
                (-1000000000.0, rrange) -> fold { acc, r -> s[r] -> e; (e > acc) -> { -true-> e; -false-> acc; } } -> mx;
                rrange -> map { r -> (r <= t) -> { -true-> { (s[r] - mx) / 16.0 -> ez; ez / 256.0 + 1.0 -> eu; (eu > 0.0) -> { -true-> eu; -false-> 0.0; } -> ev; 8 -> iota -> esq; (ev, esq) -> fold { acc, k -> acc * acc } } -false-> 0.0; } } -> p;
                (0.0, rrange) -> fold { acc, r -> acc + p[r] } -> den;
                krange -> map { j -> (0.0, rrange) -> fold { acc, r -> acc + p[r] * vv[r * 256 + j] } -> a; a / den } -> o;
                t + 1 -> t;
                -> loop;
            }
            -false-> o -> out;
        }
    }
    () -> time -> t1;
    out[0] -> println;
    out[255] -> println;
    0.0 -> zero: f32;
    (zero, out) -> fold { acc, v -> acc + v } -> total;
    total -> println;
    (zero, po) -> fold { acc, v -> acc + v } -> ptotal;
    ptotal -> println;
    "iter ms=" -> print;
    t1 - pf0 -> println;
}
