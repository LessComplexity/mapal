fn main() {
    1048576 -> iota -> i_x;
    i_x -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> x;
    262144 -> iota -> i_w1;
    i_w1 -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> w1;
    262144 -> iota -> i_w2;
    i_w2 -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> w2;
    () -> time -> t0;
    1024 -> iota -> i_b1;
    i_b1 -> map { t -> t % 13 - 6 -> widen_f32 -> v; v / 5.0 } -> b1;
    4194304 -> iota -> o_s1;
    256 -> iota -> k_s1;
    o_s1 -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, k_s1) -> fold { acc, k -> acc + x[i * 256 + k] * w1[k * 1024 + j] }
    } -> s1;
    o_s1 -> map { t -> s1[t] + b1[t % 1024] -> u; (u > 0.0) -> { -true-> u; -false-> 0.0; } -> r; r } -> hh;
    1048576 -> iota -> o_s2;
    1024 -> iota -> k_s2;
    o_s2 -> map { t ->
        t / 256 -> i;
        t % 256 -> j;
        (0.0, k_s2) -> fold { acc, k -> acc + hh[i * 1024 + k] * w2[k * 256 + j] }
    } -> s2;
    () -> time -> t1;
    s2[0] -> println;
    s2[1048575] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
