fn main() {
    262144 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    2097152 -> iota -> tb;
    tb -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    2048 -> iota -> krange;
    131072 -> iota -> tc;
    tc -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 2048 + k] * b[k * 1024 + j] }
    } -> c;
    c[0] -> println;
}
