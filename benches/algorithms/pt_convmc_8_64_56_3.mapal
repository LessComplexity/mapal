fn main() {
    36864 -> iota -> i_w;
    i_w -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> w;
    1722368 -> iota -> i_img;
    i_img -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> img;
    () -> time -> t0;
    1605632 -> iota -> o_y;
    576 -> iota -> k_y;
    o_y -> map { t ->
        t / 200704 -> b;
        t / 3136 % 64 -> co;
        t / 56 % 56 -> i;
        t % 56 -> j;
        (0.0, k_y) -> fold { acc, k -> k / 9 -> ci; k % 9 -> q; acc + w[co * 576 + k] * img[((b * 64 + ci) * 58 + i + q / 3) * 58 + j + q % 3] }
    } -> y;
    () -> time -> t1;
    y[0] -> println;
    y[1605631] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
