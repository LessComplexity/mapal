fn main() {
    114688 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> x; x / 7.0 } -> a;
    14680064 -> iota -> tb;
    tb -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> x; x / 9.0 } -> b;
    7168 -> iota -> krange;
    32768 -> iota -> tc;
    tc -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 7168 + k] * b[k * 2048 + j] }
    } -> c;
    (0.0, c) -> fold { acc, v -> acc + v } -> total;
    total -> println;
    c[0] -> println;
    c[32767] -> println;
}
