fn main() {
    4194304 -> iota -> ta;
    2048 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    () -> time -> t0;
    a -> map { v -> v * 0.25 } -> a2;
    ta -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a2[i * 2048 + k] * b[k * 2048 + j] }
    } -> c;
    () -> time -> t1;
    c[0] -> println;
    c[4194303] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
