fn main() {
    768 -> iota -> i_x0;
    i_x0 -> map {
        t -> (t % 101 * 7 + 13) % 101 - 50 -> widen_f32 -> v;
        v / 29.0
    } -> x0;
    64 -> iota -> i_g1;
    i_g1 -> map {
        t -> (t % 97 * 5 + 3) % 97 - 48 -> widen_f32 -> v;
        1.0 + v / 400.0
    } -> g1;
    8192 -> iota -> i_wqkv;
    i_wqkv -> map {
        t -> (t % 103 * 11 + 57) % 103 - 51 -> widen_f32 -> v;
        v / 232.0
    } -> wqkv;
    4096 -> iota -> i_wo;
    i_wo -> map {
        t -> (t % 97 * 5 + 3) % 97 - 48 -> widen_f32 -> v;
        v / 232.0
    } -> wo;
    96 -> iota -> i_cs;
    i_cs -> map {
        t -> (t % 89 * 3 + 1) % 89 - 44 -> widen_f32 -> v;
        v / 50.0
    } -> cs;
    96 -> iota -> i_sn;
    i_sn -> map {
        t -> (t % 107 * 13 + 7) % 107 - 53 -> widen_f32 -> v;
        v / 50.0
    } -> sn;
    12 -> iota -> rR;
    64 -> iota -> rD;
    768 -> iota -> rRD;
    1536 -> iota -> rRQ;
    16 -> iota -> rdh;
    16 -> iota -> r16;
    12 -> iota -> rT;
    384 -> iota -> rTK;
    24 -> iota -> rHT;
    288 -> iota -> rHTT;
    384 -> iota -> rTG;
    32 -> iota -> rGd;
    mut y: [f32; 768] <- x0;
    mut g: i32 <- 0;
    rR -> map {
        b -> (0.0, rD) -> fold {
            acc, i -> x0[b * 64 + i] -> rv;
            acc + rv * rv
        } -> ss;
        ss / 64.0 + 0.00001 -> ra;
        0.5 + 0.5 * ra -> s0;
        (s0, r16) -> fold {
            acc, k -> 0.5 * (acc + ra / acc)
        } -> sd;
        1.0 / sd
    } -> rinv;
    rRD -> map {
        e -> x0[e] * rinv[e / 64] * g1[e % 64]
    } -> xn;
    rRQ -> map {
        e -> e / 128 -> i;
        e % 128 -> j;
        (0.0, rD) -> fold {
            acc, k -> acc + xn[i * 64 + k] * wqkv[k * 128 + j]
        }
    } -> qkv;
    rRD -> map {
        e -> e / 64 -> i;
        e % 64 -> c;
        c % 16 -> ri;
        (ri < 8) -> {
            -true-> qkv[i * 128 + c] * cs[i * 8 + ri] - qkv[i * 128 + c + 8] * sn[i * 8 + ri];
            -false-> qkv[i * 128 + c] * cs[i * 8 + ri - 8] + qkv[i * 128 + c - 8] * sn[i * 8 + ri - 8];
        }
    } -> q;
    rTK -> map {
        e -> e / 32 -> i;
        e % 32 -> u;
        u % 16 -> ri;
        (ri < 8) -> {
            -true-> qkv[i * 128 + 64 + u] * cs[i * 8 + ri] - qkv[i * 128 + 64 + u + 8] * sn[i * 8 + ri];
            -false-> qkv[i * 128 + 64 + u] * cs[i * 8 + ri - 8] + qkv[i * 128 + 64 + u - 8] * sn[i * 8 + ri - 8];
        }
    } -> kr;
    loop {
        (g < 2) -> {
            -true-> {
                rHTT -> map {
                    e -> e / 144 -> hh;
                    e / 12 % 12 -> i;
                    e % 12 -> r;
                    (r <= i) -> {
                        -true-> {
                            (0.0, rdh) -> fold {
                                acc, u -> acc + q[i * 64 + (g * 2 + hh) * 16 + u] * kr[r * 32 + (g) * 16 + u]
                            } -> dt;
                            dt / 4.0000000
                        }
                        -false-> -1000000000.0;
                    }
                } -> s;
                rHT -> map {
                    hi -> (-1000000000.0, rT) -> fold {
                        acc, r -> s[hi * 12 + r] -> se;
                        (se > acc) -> {
                            -true-> se;
                            -false-> acc;
                        }
                    }
                } -> mx;
                rHTT -> map {
                    e -> s[e] - mx[e / 12] -> exp
                } -> pe;
                rHT -> map {
                    hi -> (0.0, rT) -> fold {
                        acc, r -> acc + pe[hi * 12 + r]
                    }
                } -> den;
                rTG -> map {
                    e -> e / 32 -> i;
                    e % 32 -> c;
                    c / 16 -> hh;
                    c % 16 -> u;
                    (0.0, rT) -> fold {
                        acc, r -> acc + pe[(hh * 12 + i) * 12 + r] * qkv[r * 128 + 96 + (g) * 16 + u]
                    } -> av;
                    av / den[hh * 12 + i]
                } -> attg;
                rRD -> map {
                    e -> e / 64 -> i;
                    e % 64 -> j;
                    (0.0, rGd) -> fold {
                        acc, k -> acc + attg[i * 32 + k] * wo[(g * 32 + k) * 64 + j]
                    } -> yo;
                    y[e] + yo
                } -> y;
                g + 1 -> g;
                -> loop;
            }
            -false-> y -> out;
        }
    }
    out[0] -> println;
    out[705] -> println;
    out[387] -> println;
    out[767] -> println;
    0.0 -> zero: f32;
    (zero, out) -> fold {
        acc, v -> acc + v * v
    } -> ssq;
    ssq -> println;
}
