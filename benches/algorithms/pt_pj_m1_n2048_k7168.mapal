fn main() {
    7168 -> iota -> i_a;
    i_a -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    14680064 -> iota -> i_b;
    i_b -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    () -> time -> t0;
    2048 -> iota -> o_c;
    7168 -> iota -> k_c;
    o_c -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, k_c) -> fold { acc, k -> acc + a[i * 7168 + k] * b[k * 2048 + j] }
    } -> c;
    () -> time -> t1;
    c[0] -> println;
    c[2047] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
