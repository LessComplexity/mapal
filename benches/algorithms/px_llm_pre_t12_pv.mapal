    96 -> iota -> i_sn;
    i_sn -> map {
        t -> (t % 107 * 13 + 7) % 107 - 53 -> widen_f32 -> v;
        v / 50.0
    } -> sn;
    12 -> iota -> rR;
    64 -> iota -> rD;
    768 -> iota -> rRD;
    1536 -> iota -> rRQ;
    16 -> iota -> rdh;
    16 -> iota -> r16;
    12 -> iota -> rT;
    384 -> iota -> rTK;
    48 -> iota -> rHT;
    576 -> iota -> rHTT;
    rR -> map {
        b -> (0.0, rD) -> fold {
