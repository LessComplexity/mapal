    } -> attf;
    rRD -> map {
        e -> e / 64 -> i;
        e % 64 -> j;
        (0.0, rD) -> fold {
            acc, k -> acc + attf[i * 64 + k] * wo[k * 64 + j]
        } -> y;
        x0[e] + y
    } -> out;
    out[0] -> println;
    out[705] -> println;
    out[387] -> println;
    out[767] -> println;
    0.0 -> zero: f32;
    (zero, out) -> fold {
        acc, v -> acc + v * v
    } -> ssq;
