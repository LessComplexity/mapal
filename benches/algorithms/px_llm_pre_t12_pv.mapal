            acc + rv * rv
        } -> ss;
        ss / 64.0 + 0.00001 -> ra;
        0.5 + 0.5 * ra -> s0;
        (s0, r16) -> fold {
            acc, k -> 0.5 * (acc + ra / acc)
        } -> sd;
        1.0 / sd
    } -> rinv;
    rRD -> map {
        e -> x0[e] * rinv[e / 64] * g1[e % 64]
    } -> xn;
    rRQ -> map {
        e -> e / 128 -> i;
        e % 128 -> j;
        (0.0, rD) -> fold {
            acc, k -> acc + xn[i * 64 + k] * wqkv[k * 128 + j]
        }
    } -> qkv;
    rRD -> map {
        e -> e / 64 -> i;
        e % 64 -> c;
        c / 16 -> rh;
        c % 16 -> ri;
        ri % 8 -> rj;
        (ri < 8) -> {
            -true-> -1.0;
            -false-> 1.0;
        } -> sg;
        qkv[i * 128 + rh * 16 + ri] -> va;
        qkv[i * 128 + rh * 16 + (ri + 8) % 16] -> vb;
        va * cs[i * 8 + rj] + sg * vb * sn[i * 8 + rj]
    } -> q;
    rTK -> map {
        e -> e / 32 -> i;
        e % 32 -> u;
        u / 16 -> rh;
        u % 16 -> ri;
        ri % 8 -> rj;
        (ri < 8) -> {
            -true-> -1.0;
            -false-> 1.0;
        } -> sg;
        qkv[i * 128 + 64 + rh * 16 + ri] -> va;
        qkv[i * 128 + 64 + rh * 16 + (ri + 8) % 16] -> vb;
        va * cs[i * 8 + rj] + sg * vb * sn[i * 8 + rj]
    } -> kr;
    rHTT -> map {
        e -> e / 144 -> hh;
        e / 12 % 12 -> i;
        e % 12 -> r;
        (r <= i) -> {
            -true-> {
                (0.0, rdh) -> fold {
                    acc, u -> acc + q[i * 64 + (hh) * 16 + u] * kr[r * 32 + (hh / 2) * 16 + u]
                } -> dt;
                dt / 4.0000000
            }
            -false-> -1000000000.0;
        }
    } -> s;
    rHT -> map {
        hi -> (-1000000000.0, rT) -> fold {
            acc, r -> s[hi * 12 + r] -> se;
            (se > acc) -> {
                -true-> se;
                -false-> acc;
            }
        }
    } -> mx;
    rHTT -> map {
        e -> s[e] - mx[e / 12] -> xz;
        (xz > -80.0) -> {
            -true-> {
                xz / 256.0 -> xy;
                1.0 + xy * (1.0 + xy * (0.5 + xy * (0.16666667 + xy * (0.041666668 + xy * 0.008333334)))) -> xp;
                8 -> iota -> xq;
                (xp, xq) -> fold {
                    acc, k -> acc * acc
                }
            }
