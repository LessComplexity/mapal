fn main() {
    32768 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    131072 -> iota -> tb;
    tb -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    256 -> iota -> krange;
    65536 -> iota -> tc;
    tc -> map { t ->
        t / 512 -> i;
        t % 512 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 256 + k] * b[k * 512 + j] }
    } -> c;
    c[0] -> println;
}
