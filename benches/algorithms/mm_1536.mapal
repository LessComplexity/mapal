fn main() {
    2359296 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    1536 -> iota -> krange;
    ta -> map { t ->
        t / 1536 -> i;
        t % 1536 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 1536 + k] * b[k * 1536 + j] }
    } -> c;
    c[0] -> println;
}
