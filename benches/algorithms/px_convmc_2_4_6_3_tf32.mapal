fn main() {
    144 -> iota -> i_w;
    i_w -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> w;
    512 -> iota -> i_img;
    i_img -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> img;
    () -> time -> t0;
    288 -> iota -> o_y;
    36 -> iota -> k_y;
    o_y -> map { t ->
        t / 144 -> b;
        t / 36 % 4 -> co;
        t / 6 % 6 -> i;
        t % 6 -> j;
        (0.0, k_y) -> fold: tf32 | f32 { acc, k -> k / 9 -> ci; k % 9 -> q; acc + w[co * 36 + k] * img[((b * 4 + ci) * 8 + i + q / 3) * 8 + j + q % 3] }
    } -> y;
    () -> time -> t1;
    y[0] -> println;
    y[287] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
