fn main() {
    524288 -> iota -> i_a;
    i_a -> map {
        t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v;
        v / 7.0
    } -> a;
    117440512 -> iota -> i_b;
    i_b -> map {
        t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v;
        v / 9.0
    } -> b;
    () -> time -> t0;
    3670016 -> iota -> o_c;
    4096 -> iota -> k_c;
    o_c -> map {
        t ->
        t / 28672 -> i;
        t % 28672 -> j;
        (0.0, k_c) -> fold: tf32 | f32 {
            acc, k -> acc + a[i * 4096 + k] * b[k * 28672 + j]
        }
    } -> c;
    () -> time -> t1;
    c[0] -> println;
    c[3670015] -> println;
    "iter ms=" -> print;
