fn main() {
    512 -> iota -> i_q;
    i_q -> map {
        t -> (t * 7 + 13) % 101 - 50 -> widen<f32> -> v;
        v / 7.0
    } -> q;
    131072 -> iota -> i_w;
    i_w -> map {
        t -> (t * 11 + 57) % 103 - 51 -> widen<f32> -> v;
        v / 9.0
    } -> w;
    () -> time -> t0;
    262144 -> iota -> o_s;
    16 -> iota -> k_d;
    32 -> iota -> r_i;
    8192 -> iota -> k_t;
    o_s -> map {
        e ->
        e / 8192 -> i;
        e % 8192 -> j;
        (0.0, k_d) -> fold {
            acc, k -> acc + q[i * 16 + k] * w[k * 8192 + j]
        }
    } -> s;
    r_i -> map {
        i -> (-1000000000.0, k_t) -> fold {
            acc, j -> s[i * 8192 + j] -> e;
            (e > acc) -> {
                -true-> e;
                -false-> acc;
            }
        }
    } -> mx;
    o_s -> map {
        t -> (s[t] - mx[t / 8192]) / 4.0 -> exp
    } -> ex;
    r_i -> map {
        i -> (0.0, k_t) -> fold {
            acc, j -> acc + ex[i * 8192 + j]
        }
    } -> den;
    o_s -> map {
        t -> ex[t] / den[t / 8192]
    } -> y;
    () -> time -> t1;
    y[0] -> println;
    y[262143] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
