fn main() {
    917504 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    132120576 -> iota -> tb;
    tb -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    7168 -> iota -> krange;
    2359296 -> iota -> tc;
    tc -> map { t ->
        t / 18432 -> i;
        t % 18432 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 7168 + k] * b[k * 18432 + j] }
    } -> c;
    c[0] -> println;
}
