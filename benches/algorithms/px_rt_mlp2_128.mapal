fn main() {
    16384 -> iota -> ta;
    128 -> iota -> krange;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    ta -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> e;
    ta -> map { t -> (t * 13 + 7) % 107 - 53 -> widen_f32 -> v; v / 15.0 } -> g;
    ta -> map { t -> (t * 17 + 29) % 109 - 54 -> widen_f32 -> v; v / 17.0 } -> p;
    krange -> map { t -> t % 13 - 6 -> widen_f32 -> v; v / 5.0 } -> bias;
    krange -> map { t -> t % 11 - 5 -> widen_f32 -> v; v / 4.0 } -> bias2;
    (0.0, 16384) -> fill -> z0;
    mut carry: [f32; 16384] <- z0;
    mut it: i32 <- 0;
    loop {
        (it < 2) -> {
            -true-> {
                ta -> map { t -> ((t + it) * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
                ta -> map { t -> ((t + it) * 3 + 1) % 89 - 44 -> widen_f32 -> v; v / 13.0 } -> f;
                ta -> map { t ->
                    t / 128 -> i;
                    t % 128 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + a[i * 128 + k] * b[k * 128 + j] }
                } -> c1;
                ta -> map { t -> c1[t] + bias[t % 128] -> u; (u > 0.0) -> { -true-> u; -false-> 0.0; } -> r; r } -> h1;
                ta -> map { t ->
                    t / 128 -> i;
                    t % 128 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + h1[i * 128 + k] * e[k * 128 + j] }
                } -> d1;
                ta -> map { t ->
                    t / 128 -> i;
                    t % 128 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + f[i * 128 + k] * g[k * 128 + j] }
                } -> c2;
                ta -> map { t -> c2[t] + bias2[t % 128] -> u; (u > 0.0) -> { -true-> u; -false-> 0.0; } -> r; r } -> h2;
                ta -> map { t ->
                    t / 128 -> i;
                    t % 128 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + h2[i * 128 + k] * p[k * 128 + j] }
                } -> d2;
                ta -> map { t -> d1[t] + d2[t] } -> h;
                h -> carry;
                it + 1 -> it;
                -> loop;
            }
            -false-> carry -> out;
        }
    }
    out[0] -> println;
    out[16383] -> println;
}
