fn main() {
    131072 -> iota -> tx;
    1048576 -> iota -> two;
    2097152 -> iota -> tup;
    2097152 -> iota -> tdn;
    262144 -> iota -> th;
    1024 -> iota -> dr;
    2048 -> iota -> hr;
    tx -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> x;
    two -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 1024.0 } -> wo;
    tup -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 1024.0 } -> wup;
    tdn -> map { t -> (t * 3 + 1) % 89 - 44 -> widen_f32 -> v; v / 2048.0 } -> wdn;
    hr -> map { t -> t % 13 - 6 -> widen_f32 -> v; v / 5.0 } -> b1;
    dr -> map { t -> t % 11 - 5 -> widen_f32 -> v; v / 4.0 } -> b2;
    () -> time -> t0;
    tx -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, dr) -> fold { acc, k -> acc + x[i * 1024 + k] * wo[k * 1024 + j] }
    } -> p;
    th -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, dr) -> fold { acc, k -> acc + p[i * 1024 + k] * wup[k * 2048 + j] }
    } -> hraw;
    th -> map { t -> hraw[t] + b1[t % 2048] -> u; (u > 0.0) -> { -true-> u; -false-> 0.0; } -> r; r } -> hh;
    tx -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, hr) -> fold { acc, k -> acc + hh[i * 2048 + k] * wdn[k * 1024 + j] }
    } -> mraw;
    tx -> map { t -> mraw[t] + b2[t % 1024] -> m; (p[t] + m) / 4.0 } -> y;
    () -> time -> t1;
    y[0] -> println;
    y[131071] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
