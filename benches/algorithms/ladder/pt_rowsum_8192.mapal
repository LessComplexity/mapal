fn main() {
    67108864 -> iota -> ta;
    8192 -> iota -> krange;
    ta -> map {
        t -> (t * 7 + 13) % 101 - 50 -> widen<f32> -> v;
        v / 7.0
    } -> a;
    ta -> map {
        t -> (t * 11 + 57) % 103 - 51 -> widen<f32> -> v;
        v / 9.0
    } -> b;
    () -> time -> t0;
    ta -> map {
        t ->
        t / 8192 -> i;
        t % 8192 -> j;
        (0.0, krange) -> fold {
            acc, k -> acc + a[i * 8192 + k] * b[k * 8192 + j]
        }
    } -> c;
    krange -> map {
        i -> (0.0, krange) -> fold {
            acc, j -> acc + c[i * 8192 + j]
        }
    } -> r;
    () -> time -> t1;
    r[0] -> println;
    r[8191] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
