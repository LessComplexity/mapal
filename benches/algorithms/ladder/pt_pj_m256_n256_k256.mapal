fn main() {
    65536 -> iota -> i_a;
    i_a -> map {
        t -> (t * 7 + 13) % 101 - 50 -> widen<f32> -> v;
        v / 7.0
    } -> a;
    65536 -> iota -> i_b;
    i_b -> map {
        t -> (t * 11 + 57) % 103 - 51 -> widen<f32> -> v;
        v / 9.0
    } -> b;
    () -> time -> t0;
    65536 -> iota -> o_c;
    256 -> iota -> k_c;
    o_c -> map {
        t ->
        t / 256 -> i;
        t % 256 -> j;
        (0.0, k_c) -> fold {
            acc, k -> acc + a[i * 256 + k] * b[k * 256 + j]
        }
    } -> c;
    () -> time -> t1;
    c[0] -> println;
    c[65535] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
