fn main() {
    36864 -> iota -> i_w;
    i_w -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> w;
    26150912 -> iota -> i_img;
    i_img -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> img;
    () -> time -> t0;
    25690112 -> iota -> o_y;
    576 -> iota -> k_y;
    o_y -> map { t ->
        t / 3211264 -> b;
        t / 50176 % 64 -> co;
        t / 224 % 224 -> i;
        t % 224 -> j;
        (0.0, k_y) -> fold: tf32 | f32 { acc, k -> k / 9 -> ci; k % 9 -> q; acc + w[co * 576 + k] * img[((b * 64 + ci) * 226 + i + q / 3) * 226 + j + q % 3] }
    } -> y;
    () -> time -> t1;
    y[0] -> println;
    y[25690111] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
