fn main() {
    4194304 -> iota -> tw;
    tw -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> x; x / 32768.0 } -> wk;
    tw -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> x; x / 32768.0 } -> wv;
    2097152 -> iota -> tc;
    2048 -> iota -> krange;
    1024 -> iota -> rrange;
    (0.0, 2097152) -> fill -> x0;
    (0.0, 2048) -> fill -> o0;
    mut x: [f32; 2097152] <- x0;
    mut o: [f32; 2048] <- o0;
    mut t: i32 <- 0;
    () -> time -> t0;
    loop {
        (t < 1024) -> {
            -true-> {
                tc -> map { c -> (c / 2048 == t) -> { -true-> { (c * 7 + 13) % 101 - 50 -> widen_f32 -> f; f / 64.0 + o[c % 2048] } -false-> x[c]; } } -> x;
                tc -> map { c ->
                    c / 2048 -> i;
                    c % 2048 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + x[i * 2048 + k] * wk[k * 2048 + j] }
                } -> kk;
                tc -> map { c ->
                    c / 2048 -> i;
                    c % 2048 -> j;
                    (0.0, krange) -> fold { acc, k -> acc + x[i * 2048 + k] * wv[k * 2048 + j] }
                } -> vv;
                krange -> map { k -> ((t * 2048 + k) * 5 + 3) % 97 - 48 -> widen_f32 -> qv; qv / 32768.0 } -> q;
                rrange -> map { r -> (0.0, krange) -> fold { acc, k -> acc + q[k] * kk[r * 2048 + k] } } -> s;
                krange -> map { j -> (0.0, rrange) -> fold { acc, r -> acc + s[r] * vv[r * 2048 + j] } } -> o;
                t + 1 -> t;
                -> loop;
            }
            -false-> o -> out;
        }
    }
    () -> time -> t1;
    out[0] -> println;
    out[2047] -> println;
    0.0 -> zero: f32;
    (zero, out) -> fold { acc, v -> acc + v } -> total;
    total -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
