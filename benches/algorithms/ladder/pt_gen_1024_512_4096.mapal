fn main() {
    16777216 -> iota -> tw;
    tw -> map {
        t -> (t * 7 + 13) % 101 - 50 -> widen<f32> -> x;
        x / 65536.0
    } -> wk;
    tw -> map {
        t -> (t * 11 + 57) % 103 - 51 -> widen<f32> -> x;
        x / 65536.0
    } -> wv;
    4194304 -> iota -> tc;
    4096 -> iota -> krange;
    1024 -> iota -> rrange;
    (0.0, 4194304) -> fill -> x0;
    (0.0, 4096) -> fill -> o0;
    mut x: [f32; 4194304] <- x0;
    mut o: [f32; 4096] <- o0;
    mut t: i32 <- 0;
    () -> time -> t0;
    loop {
        (t < 1024) -> {
            -true-> {
                tc -> map {
                    c -> (c / 4096 == t) -> {
                        -true-> {
                            (c * 7 + 13) % 101 - 50 -> widen<f32> -> f;
                            (t < 512) -> {
                                -true-> f / 64.0;
                                -false-> f / 64.0 + o[c % 4096];
                            }
                        }
                        -false-> x[c];
                    }
                } -> x;
                tc -> map {
                    c ->
                    c / 4096 -> i;
                    c % 4096 -> j;
                    (0.0, krange) -> fold {
                        acc, k -> acc + x[i * 4096 + k] * wk[k * 4096 + j]
                    }
                } -> kk;
                tc -> map {
                    c ->
                    c / 4096 -> i;
                    c % 4096 -> j;
                    (0.0, krange) -> fold {
                        acc, k -> acc + x[i * 4096 + k] * wv[k * 4096 + j]
                    }
                } -> vv;
                krange -> map {
                    k -> ((t * 4096 + k) * 5 + 3) % 97 - 48 -> widen<f32> -> qv;
                    qv / 65536.0
                } -> q;
                rrange -> map {
                    r -> (r <= t) -> {
                        -true-> {
                            (0.0, krange) -> fold {
                                acc, k -> acc + q[k] * kk[r * 4096 + k]
                            }
                        }
                        -false-> -1000000000.0;
                    }
                } -> s;
                (-1000000000.0, rrange) -> fold {
                    acc, r -> s[r] -> e;
                    (e > acc) -> {
                        -true-> e;
                        -false-> acc;
                    }
                } -> mx;
                rrange -> map {
                    r -> (r <= t) -> {
                        -true-> {
                            (s[r] - mx) / 64.0 -> ez;
                            ez / 256.0 + 1.0 -> eu;
                            (eu > 0.0) -> {
                                -true-> eu;
                                -false-> 0.0;
                            } -> ev;
                            8 -> iota -> esq;
                            (ev, esq) -> fold {
                                acc, k -> acc * acc
                            }
                        }
                        -false-> 0.0;
                    }
                } -> p;
                (0.0, rrange) -> fold {
                    acc, r -> acc + p[r]
                } -> den;
                krange -> map {
                    j -> (0.0, rrange) -> fold {
                        acc, r -> acc + p[r] * vv[r * 4096 + j]
                    } -> a;
                    a / den
                } -> o;
                t + 1 -> t;
                -> loop;
            }
            -false-> o -> out;
        }
    }
    () -> time -> t1;
    out[0] -> println;
    out[4095] -> println;
    0.0 -> zero: f32;
    (zero, out) -> fold {
        acc, v -> acc + v
    } -> total;
    total -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
