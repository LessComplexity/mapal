fn main() {
    268435456 -> iota -> ta;
    16384 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    () -> time -> t0;
    ta -> map { t ->
        t / 16384 -> i;
        t % 16384 -> j;
        (0.0, krange) -> fold { acc, k -> a[i * 16384 + k] * b[k * 16384 + j] -> xt; (xt > 0.0) -> { -true-> xt; -false-> 0.0 - xt; } -> xa; acc + xa }
    } -> c;
    krange -> map { i -> (0.0, krange) -> fold { acc, j -> c[i * 16384 + j] -> xt; (xt > 0.0) -> { -true-> xt; -false-> 0.0 - xt; } -> xa; acc + xa } } -> r;
    () -> time -> t1;
    r[0] -> println;
    r[16383] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
