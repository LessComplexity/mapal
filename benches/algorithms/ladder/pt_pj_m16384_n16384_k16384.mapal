fn main() {
    268435456 -> iota -> i_a;
    i_a -> map {
        t -> (t * 7 + 13) % 101 - 50 -> widen<f32> -> v;
        v / 7.0
    } -> a;
    268435456 -> iota -> i_b;
    i_b -> map {
        t -> (t * 11 + 57) % 103 - 51 -> widen<f32> -> v;
        v / 9.0
    } -> b;
    () -> time -> t0;
    268435456 -> iota -> o_c;
    16384 -> iota -> k_c;
    o_c -> map {
        t ->
        t / 16384 -> i;
        t % 16384 -> j;
        (0.0, k_c) -> fold {
            acc, k -> acc + a[i * 16384 + k] * b[k * 16384 + j]
        }
    } -> c;
    () -> time -> t1;
    c[0] -> println;
    c[268435455] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
