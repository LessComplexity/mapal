fn main() {
    67108864 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> x; x / 7.0 } -> a;
    67108864 -> iota -> tb;
    tb -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> x; x / 9.0 } -> b;
    8192 -> iota -> krange;
    67108864 -> iota -> tc;
    tc -> map { t ->
        t / 8192 -> i;
        t % 8192 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 8192 + k] * b[k * 8192 + j] }
    } -> c;
    (0.0, c) -> fold { acc, v -> acc + v } -> total;
    total -> println;
    c[0] -> println;
    c[67108863] -> println;
}
