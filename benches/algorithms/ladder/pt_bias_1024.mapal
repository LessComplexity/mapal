fn main() {
    1048576 -> iota -> ta;
    1024 -> iota -> krange;
    ta -> map {
        t -> (t * 7 + 13) % 101 - 50 -> widen<f32> -> v;
        v / 7.0
    } -> a;
    ta -> map {
        t -> (t * 11 + 57) % 103 - 51 -> widen<f32> -> v;
        v / 9.0
    } -> b;
    () -> time -> t0;
    krange -> map {
        t -> t % 13 - 6 -> widen<f32> -> v;
        v / 5.0
    } -> bias;
    ta -> map {
        t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, krange) -> fold {
            acc, k -> acc + a[i * 1024 + k] * b[k * 1024 + j]
        }
    } -> c;
    ta -> map {
        t -> c[t] + bias[t % 1024]
    } -> d;
    () -> time -> t1;
    d[0] -> println;
    d[1048575] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
