fn main() {
    4194304 -> iota -> ta;
    2048 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    () -> time -> t0;
    krange -> map { t -> t % 13 - 6 -> widen_f32 -> v; v / 5.0 } -> bias;
    ta -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 2048 + k] * b[k * 2048 + j] }
    } -> c;
    ta -> map { t -> c[t] + bias[t % 2048] } -> d;
    () -> time -> t1;
    d[0] -> println;
    d[4194303] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
