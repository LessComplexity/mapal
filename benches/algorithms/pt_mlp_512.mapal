fn main() {
    262144 -> iota -> ta;
    512 -> iota -> krange;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> a;
    ta -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> b;
    ta -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> e;
    () -> time -> t0;
    ta -> map { t ->
        t / 512 -> i;
        t % 512 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 512 + k] * b[k * 512 + j] }
    } -> c;
    c -> map { v -> v * 0.5 } -> h;
    ta -> map { t ->
        t / 512 -> i;
        t % 512 -> j;
        (0.0, krange) -> fold { acc, k -> acc + h[i * 512 + k] * e[k * 512 + j] }
    } -> d;
    () -> time -> t1;
    d[0] -> println;
    d[262143] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}
