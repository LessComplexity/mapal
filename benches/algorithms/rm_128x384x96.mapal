fn main() {
    12288 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> x; x / 7.0 } -> a;
    36864 -> iota -> tb;
    tb -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> x; x / 9.0 } -> b;
    96 -> iota -> krange;
    49152 -> iota -> tc;
    tc -> map { t ->
        t / 384 -> i;
        t % 384 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 96 + k] * b[k * 384 + j] }
    } -> c;
    (0.0, c) -> fold { acc, v -> acc + v } -> total;
    total -> println;
    c[0] -> println;
    c[49151] -> println;
}
