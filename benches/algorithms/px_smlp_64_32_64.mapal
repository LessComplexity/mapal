fn main() {
    2048 -> iota -> i_x;
    i_x -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> v; v / 7.0 } -> x;
    2048 -> iota -> i_w1;
    i_w1 -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> v; v / 9.0 } -> w1;
    2048 -> iota -> i_w2;
    i_w2 -> map { t -> (t * 5 + 3) % 97 - 48 -> widen_f32 -> v; v / 11.0 } -> w2;
    64 -> iota -> i_b1;
    i_b1 -> map { t -> t % 13 - 6 -> widen_f32 -> v; v / 5.0 } -> b1;
    4096 -> iota -> o_s1;
    32 -> iota -> k_s1;
    o_s1 -> map { t ->
        t / 64 -> i;
        t % 64 -> j;
        (0.0, k_s1) -> fold { acc, k -> acc + x[i * 32 + k] * w1[k * 64 + j] }
    } -> s1;
    o_s1 -> map { t -> s1[t] + b1[t % 64] -> u; (u > 0.0) -> { -true-> u; -false-> 0.0; } -> r; r } -> hh;
    2048 -> iota -> o_s2;
    64 -> iota -> k_s2;
    o_s2 -> map { t ->
        t / 32 -> i;
        t % 32 -> j;
        (0.0, k_s2) -> fold { acc, k -> acc + hh[i * 64 + k] * w2[k * 32 + j] }
    } -> s2;
    0.0 -> zero: f32;
    (zero, s2) -> fold { acc, v -> acc + v } -> s_s2;
    s_s2 -> println;
    s2[0] -> println;
    s2[2047] -> println;
}
