fn main() {
    10000 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 -> x; x / 7.0 } -> a;
    10000 -> iota -> tb;
    tb -> map { t -> (t * 11 + 57) % 103 - 51 -> widen_f32 -> x; x / 9.0 } -> b;
    100 -> iota -> krange;
    10000 -> iota -> tc;
    tc -> map { t ->
        t / 100 -> i;
        t % 100 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 100 + k] * b[k * 100 + j] }
    } -> c;
    (0.0, c) -> fold { acc, v -> acc + v } -> total;
    total -> println;
    c[0] -> println;
    c[9999] -> println;
}
