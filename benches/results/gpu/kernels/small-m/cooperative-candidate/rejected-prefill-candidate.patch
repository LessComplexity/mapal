+    #[test]
+    fn skinny_cooperative_copies_cover_each_panel_once() {
+        use std::collections::BTreeSet;
+        for p in PARTS {
+            for (n, depth) in [(18432, 7168), (2048, 7168), (1024, 4096)] {
+                for (arm, brm) in [(true, true), (false, true), (true, false)] {
+                    for elem in [Ty::f32(), Ty::f64()] {
+                        let s = site(16, n, depth, arm, brm, elem);
+                        let selected = launch(&s, p, false, crate::GpuArms::default(), None);
+                        println!(
+                            "{} N{n} K{depth} A_rm{arm} B_rm{brm} {:?}: {:?}",
+                            p.name, s.elem, selected.tiled
+                        );
+                        for r in arms() {
+                            let Some(g) = launch(&s, p, false, force(r), None).tiled else {
+                                continue;
+                            };
+                            let lanes = GPU_VEC_BYTES / elem_bytes_of(&s.elem);
+                            for (i, (map, loads)) in lane_maps(&s, &g).into_iter().enumerate() {
+                                let mut seen = BTreeSet::new();
+                                let vec = if i == 0 {
+                                    vector_a(&s) && g.stages < 2
+                                } else {
+                                    vector_b(&s)
+                                };
+                                let width = if vec { lanes } else { 1 };
+                                for copy in 0..loads {
+                                    for tid in 0..g.threads() {
+                                        let (row, col) =
+                                            map.coords(&mut Num, &(tid + copy * g.threads()));
+                                        for v in 0..width {
+                                            assert!(
+                                                seen.insert((row, col + v)),
+                                                "duplicate panel element"
+                                            );
+                                        }
+                                        assert!(affine_delta(map, g.threads(), copy).is_some());
+                                    }
+                                }
+                                let (rows, cols) = if i == 0 {
+                                    (g.bm(), g.bk)
+                                } else {
+                                    (g.bk, g.bn())
+                                };
+                                assert_eq!(seen.len() as u64, rows * cols);
+                                assert!(seen.iter().all(|&(row, col)| row < rows && col < cols));
+                            }
+                        }
+                    }
+                }
+            }
+        }
