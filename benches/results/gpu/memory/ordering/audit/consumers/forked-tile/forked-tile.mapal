fn main() {
    4096 -> iota -> ta;
    64 -> iota -> krange;
    ta -> map { t -> (t % 7 + 1) -> widen_f32 } -> a;
    ta -> map { t -> (t % 5 + 2) -> widen_f32 } -> b;
    ta -> map { t -> (t % 11 + 1) -> widen_f32 } -> e;
    ta -> map { t -> (t % 13 + 1) -> widen_f32 } -> f;
    ta -> map { t ->
        t / 64 -> i;
        t % 64 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 64 + k] * b[k * 64 + j] }
    } -> c1;
    c1 -> map { v -> v * 2.0 } -> h1;
    ta -> map { t ->
        t / 64 -> i;
        t % 64 -> j;
        (0.0, krange) -> fold { acc, k -> acc + h1[i * 64 + k] * e[k * 64 + j] }
    } -> left;
    ta -> map { t ->
        t / 64 -> i;
        t % 64 -> j;
        (0.0, krange) -> fold { acc, k -> acc + h1[i * 64 + k] * f[k * 64 + j] }
    } -> right;
    right[0] -> println;
    right[4095] -> println;
    left[0] -> println;
    left[4095] -> println;
    h1[0] -> println;
    h1[4095] -> println;
    a[0] -> println;
    b[0] -> println;
    e[0] -> println;
    f[0] -> println;
    c1[0] -> println;
    c1[4095] -> println;
}
