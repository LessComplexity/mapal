+        // The existing base-output row-fold veto also remains conservative.
+        let raw = GROUPED_ROW_FOLD.replace("acc + h1[i * 64 + j]", "acc + c1[i * 64 + j]");
+        let e = grouped(&raw, contract);
+        assert_eq!(init_flags(&e.text) & 2, 0);
+    }
+}
