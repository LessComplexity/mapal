+#[test]
+fn grouped_member_row_fold_keeps_its_ordered_whole_copy() {
+    for contract in [false, true] {
+        let e = grouped(GROUPED_ROW_FOLD, contract);
+        let t = calls(&e.text);
+        let first = t.iter().position(|x| x == "launchv 1").expect("producer");
