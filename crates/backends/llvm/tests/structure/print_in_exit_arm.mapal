// A loop-carrying fn whose exit arm prints the final state before returning it.
fn run(x: [f32; 64]) -> [f32; 64] {
    mut hidden: [f32; 64] <- x;
    mut layer: i32 <- 0;
    loop {
        (layer < 3) -> {
            -true-> {
                64 -> iota -> map {
                    i -> hidden[i] * 0.5 + 1.0
                } -> hidden;
                layer + 1 -> layer;
                -> loop;
            }
            -false-> {
                hidden[0] -> println;
                hidden -> ret;
            }
        }
    }
}

fn main() {
    64 -> iota -> map {
        i -> i -> widen<f32>
    } -> x;
    x -> run -> y;
    y[0] -> println;
    y[5] -> println;
}
