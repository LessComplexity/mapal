// Three steps over every sample: scale, shift, clip below zero. Each `map` says its cells are independent.
1024 -> samples;

fn main() {
    samples -> iota -> map {
        i -> i -> widen_f32
    } -> signal;
    signal -> map {
        v -> v * 0.25
    } -> scaled;
    scaled -> map {
        v -> v - 100.0
    } -> shifted;
    shifted -> map {
        v -> (v > 0.0) -> {
            -true-> v;
            -false-> 0.0;
        }
    } -> clipped;
    (0.0, clipped) -> fold {
        sum, v -> sum + v
    } -> total;
    clipped[samples - 1] -> println;
    total -> println;
}
