// A linear layer with bf16 weights: out[t][row] = sum over columns of weight[row][column] * x[t][column].
128 -> tokens;
4096 -> rows;
4096 -> columns;

fn main() {
    "weight.bin" -> read -> weight: [bf16; rows * columns];
    "activations.bin" -> read -> x: [f32; tokens * columns];
    columns -> iota -> along;
    tokens * rows -> iota -> map {
        cell ->
        cell / rows -> t;
        cell % rows -> row;
        (0.0, along) -> fold: bf16 | f32 {
            sum, column -> weight[row * columns + column] -> widen_f32 -> w;
            sum + w * x[t * columns + column]
        }
    } -> out;
    (0.0, out) -> fold {
        sum, v -> sum + v
    } -> checksum;
    out[0] -> println;
    checksum -> println;
}
