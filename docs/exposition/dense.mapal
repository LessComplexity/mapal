// A dense layer: a matrix product, a bias and a ReLU. What to compute, not how.
2048 -> n;

fn main() {
    n * n -> iota -> cells;
    n -> iota -> along;
    cells -> map {
        c -> (c * 7 + 13) % 101 - 50 -> widen_f32
    } -> a;
    cells -> map {
        c -> (c * 5 + 3) % 97 - 48 -> widen_f32
    } -> b;
    cells -> map {
        c ->
        c / n -> row;
        c % n -> column;
        (0.0, along) -> fold {
            sum, k -> sum + a[row * n + k] * b[k * n + column]
        } -> dot;
        (dot + 1.0 > 0.0) -> {
            -true-> dot + 1.0;
            -false-> 0.0;
        }
    } -> out;
    out[0] -> println;
    out[n * n - 1] -> println;
}
