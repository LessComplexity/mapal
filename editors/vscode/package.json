{
  "name": "mapal-lang",
  "displayName": "Mapal",
  "description": "Syntax highlighting, formatting and file icon for the Mapal dataflow language.",
  "version": "0.2.0",
  "publisher": "mapal-lang",
  "license": "Apache-2.0 WITH LLVM-exception",
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:mapal"
  ],
  "contributes": {
    "configuration": {
      "title": "Mapal",
      "properties": {
        "mapal.executablePath": {
          "type": "string",
          "default": "mapal",
          "scope": "machine-overridable",
          "description": "Executable name or absolute path to the Mapal CLI used for formatting. Arguments are not supported."
        }
      }
    },
    "configurationDefaults": {
      "[mapal]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
      }
    },
    "languages": [
      {
        "id": "mapal",
        "aliases": [
          "Mapal",
          "flow"
        ],
        "extensions": [
          ".mapal"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mapal.svg",
          "dark": "./icons/mapal.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mapal",
        "scopeName": "source.mapal",
        "path": "./syntaxes/mapal.tmLanguage.json"
      }
    ]
  }
}
