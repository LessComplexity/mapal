{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mapal",
  "scopeName": "source.mapal",
  "comment": "What a highlighter that sees one line at a time can know; the language server's semantic tokens (mapped back to these scopes by package.json semanticTokenScopes) know the rest. The classes and their scopes: editors/test/classes.tsv; every token of the shared fixture: editors/test/fixture.tokens.tsv (column `static`); test: editors/vscode/test/scope_test.py. PRECEDENCE: TextMate takes the EARLIEST match, the first listed on a tie, so this file is ordered most-specific first; the Vim file (last match wins) is ordered the other way round.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#guards"
    },
    {
      "include": "#fn-declaration"
    },
    {
      "include": "#type-declaration"
    },
    {
      "include": "#size-arguments"
    },
    {
      "include": "#reserved"
    },
    {
      "include": "#mut-binding"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#call-position"
    },
    {
      "include": "#binding"
    },
    {
      "include": "#assign-binding"
    },
    {
      "include": "#arrows"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#default-field"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mapal",
          "match": "//.*$",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "keyword.codetag.notation.mapal",
                  "match": "\\b(TODO|FIXME|XXX|NOTE)\\b"
                }
              ]
            }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mapal",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mapal",
          "match": "\\\\[nt\"\\\\]"
        }
      ]
    },
    "guards": {
      "comment": "Guard arrows (single lexemes, ADR-0010): the chrome reads as an arrow, the discriminant as what it is. The name right after one heads the arm's chain, a read: it is consumed here unscoped, or the binding / call rules would claim it (`-false-> b;`). Must precede #arrows and #operators or the bare `-` wins.",
      "patterns": [
        {
          "match": "(-)(true|false)(->)(?:\\s*(?!(?:enumerate|to_f8e4m3|to_f8e5m2|widen_f32|widen_f64|widen_i64|category|executor|println|to_bf16|f8e4m3|f8e5m2|to_f16|false|print|bf16|bool|fill|fold|iota|loop|read|sqrt|tf32|time|true|type|void|cos|exp|f16|f32|f64|i32|i64|map|mut|pub|ret|seq|sin|use|zip|fn|u8)\\b)([a-z_]\\w*))?",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.mapal"
            },
            "2": {
              "name": "constant.language.boolean.mapal"
            },
            "3": {
              "name": "keyword.operator.arrow.mapal"
            }
          }
        },
        {
          "match": "(-)([0-9]+)(->)(?:\\s*(?!(?:enumerate|to_f8e4m3|to_f8e5m2|widen_f32|widen_f64|widen_i64|category|executor|println|to_bf16|f8e4m3|f8e5m2|to_f16|false|print|bf16|bool|fill|fold|iota|loop|read|sqrt|tf32|time|true|type|void|cos|exp|f16|f32|f64|i32|i64|map|mut|pub|ret|seq|sin|use|zip|fn|u8)\\b)([a-z_]\\w*))?",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.mapal"
            },
            "2": {
              "name": "constant.numeric.integer.mapal"
            },
            "3": {
              "name": "keyword.operator.arrow.mapal"
            }
          }
        },
        {
          "match": "(-)(_)(->)(?:\\s*(?!(?:enumerate|to_f8e4m3|to_f8e5m2|widen_f32|widen_f64|widen_i64|category|executor|println|to_bf16|f8e4m3|f8e5m2|to_f16|false|print|bf16|bool|fill|fold|iota|loop|read|sqrt|tf32|time|true|type|void|cos|exp|f16|f32|f64|i32|i64|map|mut|pub|ret|seq|sin|use|zip|fn|u8)\\b)([a-z_]\\w*))?",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.mapal"
            },
            "2": {
              "name": "variable.language.wildcard.mapal"
            },
            "3": {
              "name": "keyword.operator.arrow.mapal"
            }
          }
        }
      ]
    },
    "fn-declaration": {
      "comment": "`fn name` and its size parameters `fn f<rows, columns>` (ADR-0047). A builtin or primitive name stays one (the Vim keywords win there too).",
      "match": "\\b(fn)\\s+(?:(enumerate|to_f8e4m3|to_f8e5m2|widen_f32|widen_f64|widen_i64|println|to_bf16|to_f16|print|fill|iota|read|sqrt|time|cos|exp|sin|zip)\\b|(f8e4m3|f8e5m2|bf16|bool|tf32|f16|f32|f64|i32|i64|u8)\\b|([A-Za-z_]\\w*))(?:\\s*(<)([^<>]*)(>))?",
      "captures": {
        "1": {
          "name": "keyword.control.mapal"
        },
        "2": {
          "name": "support.function.builtin.mapal"
        },
        "3": {
          "name": "support.type.primitive.mapal"
        },
        "4": {
          "name": "entity.name.function.mapal"
        },
        "5": {
          "name": "punctuation.definition.size.mapal"
        },
        "6": {
          "patterns": [
            {
              "name": "variable.other.constant.size.mapal",
              "match": "\\b[a-z_]\\w*\\b"
            },
            {
              "name": "constant.numeric.integer.mapal",
              "match": "\\b[0-9]+\\b"
            },
            {
              "name": "keyword.operator.mapal",
              "match": "[+\\-*]"
            }
          ]
        },
        "7": {
          "name": "punctuation.definition.size.mapal"
        }
      }
    },
    "type-declaration": {
      "comment": "`type Name` and its size parameters `type Matrix<rows, columns>` (ADR-0048 D4). A builtin or primitive name stays one (the Vim keywords win there too).",
      "match": "\\b(type)\\s+(?:(enumerate|to_f8e4m3|to_f8e5m2|widen_f32|widen_f64|widen_i64|println|to_bf16|to_f16|print|fill|iota|read|sqrt|time|cos|exp|sin|zip)\\b|(f8e4m3|f8e5m2|bf16|bool|tf32|f16|f32|f64|i32|i64|u8)\\b|([A-Za-z_]\\w*))(?:\\s*(<)([^<>]*)(>))?",
      "captures": {
        "1": {
          "name": "keyword.control.mapal"
        },
        "2": {
          "name": "support.function.builtin.mapal"
        },
        "3": {
          "name": "support.type.primitive.mapal"
        },
        "4": {
          "name": "entity.name.type.mapal"
        },
        "5": {
          "name": "punctuation.definition.size.mapal"
        },
        "6": {
          "patterns": [
            {
              "name": "variable.other.constant.size.mapal",
              "match": "\\b[a-z_]\\w*\\b"
            },
            {
              "name": "constant.numeric.integer.mapal",
              "match": "\\b[0-9]+\\b"
            },
            {
              "name": "keyword.operator.mapal",
              "match": "[+\\-*]"
            }
          ]
        },
        "7": {
          "name": "punctuation.definition.size.mapal"
        }
      }
    },
    "size-arguments": {
      "comment": "A size-generic type at its sizes, `Matrix<hidden_size, 64>` (ADR-0048 D4).",
      "match": "\\b([A-Z]\\w*)(<)([^<>]*)(>)",
      "captures": {
        "1": {
          "name": "entity.name.type.mapal"
        },
        "2": {
          "name": "punctuation.definition.size.mapal"
        },
        "3": {
          "patterns": [
            {
              "name": "variable.other.constant.size.mapal",
              "match": "\\b[a-z_]\\w*\\b"
            },
            {
              "name": "constant.numeric.integer.mapal",
              "match": "\\b[0-9]+\\b"
            },
            {
              "name": "keyword.operator.mapal",
              "match": "[+\\-*]"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.size.mapal"
        }
      }
    },
    "reserved": {
      "comment": "ADR-0006: `category` was the v0.1 spelling of `type`; reserved and rejected.",
      "name": "invalid.illegal.reserved.mapal",
      "match": "\\b(category)\\b"
    },
    "mut-binding": {
      "comment": "`mut name` binds (a statement `mut x: T <- e` or a stage `-> mut x`). Same exclusion as #call-position: a keyword, builtin or primitive type after `mut` stays what it is (#keywords).",
      "match": "\\b(mut)\\s+(?!(?:enumerate|to_f8e4m3|to_f8e5m2|widen_f32|widen_f64|widen_i64|category|executor|println|to_bf16|f8e4m3|f8e5m2|to_f16|false|print|bf16|bool|fill|fold|iota|loop|read|sqrt|tf32|time|true|type|void|cos|exp|f16|f32|f64|i32|i64|map|mut|pub|ret|seq|sin|use|zip|fn|u8)\\b)([a-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.control.mapal"
        },
        "2": {
          "name": "variable.other.definition.mapal"
        }
      }
    },
    "keywords": {
      "comment": "The language's own lists: mapal-syntax KEYWORDS, mapal-lower builtin_names and SCALAR_TYPES (+ the `: compute` member tf32). Test: crates/mapal-lsp/tests/highlight.rs grammar_name_lists_are_the_languages.",
      "patterns": [
        {
          "name": "keyword.control.mapal",
          "match": "\\b(fn|type|mut|loop|seq|map|fold|executor|pub|use|void)\\b"
        },
        {
          "name": "keyword.control.return.mapal",
          "match": "\\b(ret)\\b"
        },
        {
          "name": "support.function.builtin.mapal",
          "match": "\\b(print|println|time|read|zip|enumerate|iota|fill|exp|sqrt|sin|cos|widen_i64|widen_f32|widen_f64|to_bf16|to_f16|to_f8e4m3|to_f8e5m2)\\b"
        },
        {
          "name": "constant.language.boolean.mapal",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "support.type.primitive.mapal",
          "match": "\\b(i32|i64|u8|f32|f64|bf16|f16|f8e4m3|f8e5m2|bool|tf32)\\b"
        }
      ]
    },
    "call-position": {
      "comment": "Between two arrows a name is applied: `data -> f -> g -> ret;`. The match starts at the whitespace after the arrow, one column EARLIER than #keywords, so it wins on position however the patterns are ordered: the exclusion keeps it off keywords, builtins and primitive types (scope_test.py checks it lists them all).",
      "match": "(?<=->)\\s*(?!(?:enumerate|to_f8e4m3|to_f8e5m2|widen_f32|widen_f64|widen_i64|category|executor|println|to_bf16|f8e4m3|f8e5m2|to_f16|false|print|bf16|bool|fill|fold|iota|loop|read|sqrt|tf32|time|true|type|void|cos|exp|f16|f32|f64|i32|i64|map|mut|pub|ret|seq|sin|use|zip|fn|u8)\\b)([a-z_]\\w*)(?=\\s*->)",
      "captures": {
        "1": {
          "name": "entity.name.function.call.mapal"
        }
      }
    },
    "binding": {
      "comment": "`-> name;` and `-> name: T` bind (or rebind a `mut`). A terminal call of a function that returns nothing (`-> shout;`) looks the same; the language server tells them apart. Same exclusion as #call-position, same reason.",
      "match": "(?<=->)\\s*(?!(?:enumerate|to_f8e4m3|to_f8e5m2|widen_f32|widen_f64|widen_i64|category|executor|println|to_bf16|f8e4m3|f8e5m2|to_f16|false|print|bf16|bool|fill|fold|iota|loop|read|sqrt|tf32|time|true|type|void|cos|exp|f16|f32|f64|i32|i64|map|mut|pub|ret|seq|sin|use|zip|fn|u8)\\b)([a-z_]\\w*)(?=\\s*(?:;|:(?!:)))",
      "captures": {
        "1": {
          "name": "variable.other.definition.mapal"
        }
      }
    },
    "assign-binding": {
      "comment": "`name <- value` binds.",
      "match": "\\b([a-z_]\\w*)(?=\\s*<-)",
      "captures": {
        "1": {
          "name": "variable.other.definition.mapal"
        }
      }
    },
    "arrows": {
      "comment": "Composition is the language, so arrows are deliberately prominent.",
      "name": "keyword.operator.arrow.mapal",
      "match": "->|<-"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mapal",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.mapal",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "types": {
      "comment": "PascalCase names are types.",
      "name": "entity.name.type.mapal",
      "match": "\\b[A-Z]\\w*\\b"
    },
    "default-field": {
      "comment": "ADR-0048 D5: `_`, a type's default interpretation.",
      "name": "variable.language.default.mapal",
      "match": "\\b_\\b"
    },
    "operators": {
      "comment": "`|` separates `: compute` members (`fold: bf16 | f32`).",
      "name": "keyword.operator.mapal",
      "match": "==|!=|<=|>=|&&|\\|\\||[+\\-*/%=!<>|]"
    }
  }
}
